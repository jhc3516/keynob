<Window x:Class="Keynob.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keynob"
        Width="960"
        Height="600"
        MinWidth="820"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#101719"
        FontFamily="Malgun Gothic">
    <Window.Resources>
        <LinearGradientBrush x:Key="PageBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D1718" Offset="0" />
            <GradientStop Color="#162327" Offset="0.55" />
            <GradientStop Color="#29261D" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PanelBrush" Color="#D91B292C" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#3F647078" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#49E3C2" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9FB4B6" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="22" />
        </Style>

        <Style x:Key="KeyButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="MinHeight" Value="88" />
            <Setter Property="Foreground" Value="#EDF8F5" />
            <Setter Property="Background" Value="#243538" />
            <Setter Property="BorderBrush" Value="#426065" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#30494C" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#49E3C2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFCB5B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Foreground" Value="#0C2421" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#70F0D5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KnobTurnButtonStyle" TargetType="Button" BasedOn="{StaticResource KeyButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="ColorPreviewButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="BorderBrush" Value="#70FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ColorChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ColorChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ColorChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LedSubsectionHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="#183A37" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="10,5,8,5" />
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>

        <Style x:Key="LedSubsectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#D7FFF6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="HelpToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="8,1,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Background" Value="#173033" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="HelpChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HelpChrome" Property="Background" Value="#24504D" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HelpChrome" Property="BorderBrush" Value="#FFCB5B" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="HelpChrome" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="#0C2421" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageBackground}">
        <Ellipse Width="480" Height="480" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-220,-250,0,0" Fill="#1849E3C2" IsHitTestVisible="False" />
        <Ellipse Width="540" Height="540" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-260,-320" Fill="#16FFB84A" IsHitTestVisible="False" />

        <Grid Margin="34,26,34,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="KEYNOB"
                               FontFamily="Bahnschrift SemiCondensed"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="#F4FAF7" />
                    <TextBlock Text="AI 도구를 손끝에서 · ChatGPT 앱과 Codex CLI"
                               Margin="2,5,0,0"
                               FontSize="14"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <Border Grid.Column="1" CornerRadius="18" Background="#182B3031" BorderBrush="#41626A6C" BorderThickness="1" Padding="18,10">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="HeaderStatusDot" Width="10" Height="10" Fill="#FFCB5B" Margin="0,0,9,0" />
                        <TextBlock x:Name="HeaderStatusText" Text="장치 확인 중" MaxWidth="260" TextWrapping="Wrap"
                                   Foreground="#EDF8F5" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.75*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="13" Background="#2349E3C2" Margin="0,0,15,0">
                                <TextBlock Text="USB" FontFamily="Bahnschrift" FontSize="13" FontWeight="Bold" Foreground="#70F0D5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="DeviceTitleText" Text="키보드를 찾고 있습니다" FontSize="16" FontWeight="SemiBold" Foreground="#F4FAF7" />
                                <TextBlock x:Name="DeviceDetailText" Text="정확한 장치 시리얼까지 확인합니다" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="RuntimeStatusText" Text="입력 엔진과 Codex 훅을 확인합니다" Margin="0,3,0,0" Foreground="#7FA7A5" FontSize="11" />
                                <TextBlock x:Name="BluetoothStatusText" Text="Bluetooth 입력 상태를 확인합니다" Margin="0,2,0,0" Foreground="#7FA7A5" FontSize="11" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="다시 확인" Style="{StaticResource ActionButtonStyle}" Click="RefreshDevice_Click" />
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="InputListScrollViewer" Grid.Row="2"
                                  AutomationProperties.Name="키와 노브 목록"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Style="{StaticResource PanelStyle}" Margin="0,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="184" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Grid Margin="4,0,4,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="LAYER" Margin="0,0,8,0" VerticalAlignment="Center"
                                                   FontFamily="Bahnschrift" FontWeight="Bold" Foreground="#FFCB5B" />
                                        <Button x:Name="Layer1Button" Content="1" Tag="1" Width="34" Height="26" Padding="0"
                                                Margin="0,0,5,0" AutomationProperties.Name="레이어 1 선택"
                                                Style="{StaticResource ActionButtonStyle}" Click="LayerButton_Click" />
                                        <Button x:Name="Layer2Button" Content="2" Tag="2" Width="34" Height="26" Padding="0"
                                                Margin="0,0,5,0" AutomationProperties.Name="레이어 2 선택"
                                                Style="{StaticResource ActionButtonStyle}" Click="LayerButton_Click" />
                                        <Button x:Name="Layer3Button" Content="3" Tag="3" Width="34" Height="26" Padding="0"
                                                AutomationProperties.Name="레이어 3 선택"
                                                Style="{StaticResource ActionButtonStyle}" Click="LayerButton_Click" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Keys}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" Rows="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource KeyButtonStyle}" Click="KeyButton_Click">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding NumberLabel}" FontFamily="Bahnschrift" FontSize="12" Foreground="#49E3C2" />
                                                    <TextBlock Grid.Row="1" Text="{Binding ActionLabel}" Margin="0,7,0,0" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="18,25,0,0">
                                <StackPanel Margin="0,0,0,18">
                                    <Button Height="78" Margin="18,0" Style="{StaticResource KeyButtonStyle}"
                                            Tag="knob1_press" Click="KnobInput_Click"
                                            AutomationProperties.Name="노브 1 누름">
                                        <StackPanel>
                                            <TextBlock Text="KNOB 1" HorizontalAlignment="Center" FontFamily="Bahnschrift" FontWeight="Bold" Foreground="#49E3C2" />
                                            <TextBlock x:Name="Knob1PressActionText" Text="사용 안 함" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="#EDF8F5" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="Knob1CcwButton" Grid.Column="0" Content="↶ 사용 안 함" Tag="knob1_ccw" Click="KnobInput_Click"
                                                AutomationProperties.Name="노브 1 왼쪽 회전" Style="{StaticResource KnobTurnButtonStyle}" />
                                        <Button x:Name="Knob1CwButton" Grid.Column="1" Content="사용 안 함 ↷" Tag="knob1_cw" Click="KnobInput_Click"
                                                AutomationProperties.Name="노브 1 오른쪽 회전" Style="{StaticResource KnobTurnButtonStyle}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel>
                                    <Button Height="78" Margin="18,0" Style="{StaticResource KeyButtonStyle}"
                                            Tag="knob2_press" Click="KnobInput_Click"
                                            AutomationProperties.Name="노브 2 누름">
                                        <StackPanel>
                                            <TextBlock Text="KNOB 2" HorizontalAlignment="Center" FontFamily="Bahnschrift" FontWeight="Bold" Foreground="#FFCB5B" />
                                            <TextBlock x:Name="Knob2PressActionText" Text="사용 안 함" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="#EDF8F5" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="Knob2CcwButton" Grid.Column="0" Content="↶ 사용 안 함" Tag="knob2_ccw" Click="KnobInput_Click"
                                                AutomationProperties.Name="노브 2 왼쪽 회전" Style="{StaticResource KnobTurnButtonStyle}" />
                                        <Button x:Name="Knob2CwButton" Grid.Column="1" Content="사용 안 함 ↷" Tag="knob2_cw" Click="KnobInput_Click"
                                                AutomationProperties.Name="노브 2 오른쪽 회전" Style="{StaticResource KnobTurnButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </ScrollViewer>
                </Grid>

                <ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="2"
                              AutomationProperties.Name="설정과 LED 패널"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">
                    <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="KEY별 세팅" FontFamily="Bahnschrift SemiCondensed" FontSize="20" Foreground="#F4FAF7" />
                            <TextBlock x:Name="SelectedInputText" Text="LAYER 1 · KEY 1 · 사용 안 함" Margin="0,9,0,18" Foreground="#49E3C2" FontWeight="SemiBold" />

                            <TextBlock Text="적용 범위" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <ComboBox x:Name="ScopeCombo" Margin="0,7,0,12" Height="38"
                                      AutomationProperties.Name="적용 범위"
                                      DisplayMemberPath="Label" SelectionChanged="BindingEditor_SelectionChanged" />

                            <TextBlock Text="동작 종류" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <ComboBox x:Name="ActionKindCombo" Margin="0,7,0,12" Height="38"
                                      AutomationProperties.Name="동작 종류"
                                      DisplayMemberPath="Label" SelectionChanged="BindingEditor_SelectionChanged" />

                            <StackPanel x:Name="ShortcutEditorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="단축키" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ShortcutTextBox" Height="38" IsReadOnly="True" Padding="9"
                                             AutomationProperties.Name="기록된 단축키"
                                             VerticalContentAlignment="Center" Text="기록되지 않음" />
                                    <Button Grid.Column="1" x:Name="RecordShortcutButton" Content="기록" Margin="8,0,0,0"
                                            AutomationProperties.Name="단축키 기록"
                                            Style="{StaticResource ActionButtonStyle}" Click="RecordShortcut_Click" />
                                </Grid>
                                <TextBlock x:Name="ShortcutHelpText" Text="기록을 누른 뒤 원하는 키를 함께 누르세요. 기록 중에는 버튼을 다시 눌러 취소할 수 있습니다."
                                           Margin="0,6,0,0" Foreground="#9FB4B6" FontSize="11" TextWrapping="Wrap" />
                                <Expander Header="지원 키 안내" Margin="0,10,0,0" IsExpanded="False"
                                          AutomationProperties.Name="지원 키 안내"
                                          Foreground="#E8F3F1" FontSize="12" FontWeight="SemiBold">
                                    <Border x:Name="ShortcutSupportGuidePanel"
                                            Margin="0,8,0,0" Padding="12"
                                            Background="#162528" BorderBrush="#355157" BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="지원 키 종류" Foreground="#F1F8F6" FontSize="12"
                                                       FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <ItemsControl x:Name="ShortcutSupportGroupList"
                                                          AutomationProperties.Name="지원 키 종류별 목록">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,6" Padding="9,8"
                                                                Background="#1D3033" BorderBrush="#2F4A4F"
                                                                BorderThickness="1" CornerRadius="6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="86" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Title}" Foreground="#70F0D5"
                                                                           FontSize="11" FontWeight="SemiBold"
                                                                           LineHeight="18" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Keys}"
                                                                           Foreground="#E0ECEA" FontSize="12"
                                                                           LineHeight="20" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Border Margin="0,6,0,0" Padding="10"
                                                    Background="#20332F" BorderBrush="#3C6B61"
                                                    BorderThickness="1" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Text="현재 범위" Foreground="#70F0D5" FontSize="11"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock x:Name="ShortcutSupportGuideText"
                                                               AutomationProperties.Name="선택한 범위의 단축키 제한"
                                                               Margin="0,5,0,0" Foreground="#E7F2F0" FontSize="11"
                                                               LineHeight="18" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="기록 규칙" Foreground="#F1F8F6" FontSize="11"
                                                       FontWeight="SemiBold" Margin="0,12,0,5" />
                                            <TextBlock Text="• 보조키 최대 4개 + 일반 키 1개, 또는 보조키만 기록할 수 있습니다."
                                                       Foreground="#C2D2D2" FontSize="11" LineHeight="18"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="• 숫자 키패드 Enter는 일반 Enter와 같은 키로 기록됩니다."
                                                       Margin="0,3,0,0" Foreground="#C2D2D2" FontSize="11"
                                                       LineHeight="18" TextWrapping="Wrap" />

                                            <Border Margin="0,12,0,0" Padding="10"
                                                    Background="#302B20" BorderBrush="#66583A"
                                                    BorderThickness="1" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Text="지원하지 않는 키" Foreground="#FFCB5B" FontSize="11"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="볼륨·재생·브라우저 키와 한/영·한자 키는 현재 지원하지 않습니다."
                                                               Margin="0,5,0,0" Foreground="#DDD3B9" FontSize="11"
                                                               LineHeight="18" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>

                            <StackPanel x:Name="TextEditorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="입력할 텍스트" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                <TextBox x:Name="ActionTextBox" Margin="0,7,0,0" MinHeight="72" MaxHeight="130"
                                         AutomationProperties.Name="입력할 텍스트"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         MaxLength="2000" TextChanged="ActionTextBox_TextChanged" />
                                <TextBlock x:Name="TextScopeHelpText" Text="평문으로 저장됩니다. 비밀번호나 비밀 정보는 넣지 마세요."
                                           Margin="0,6,0,0" Foreground="#FFCB5B" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel x:Name="BuiltInEditorPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="기본 기능" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                <ComboBox x:Name="BuiltInActionCombo" Margin="0,7,0,0" Height="38"
                                          AutomationProperties.Name="기본 기능" DisplayMemberPath="Label"
                                          SelectionChanged="BuiltInActionCombo_SelectionChanged" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button x:Name="PreviewSettingsButton" Content="설정 미리보기" Margin="0,0,4,0"
                                        AutomationProperties.Name="설정 미리보기"
                                        Style="{StaticResource ActionButtonStyle}" Click="PreviewSettings_Click" />
                                <Button Grid.Column="1" x:Name="TestSettingsButton" Content="실제 시험" Margin="4,0,0,0"
                                        AutomationProperties.Name="선택 동작 실제 시험"
                                        Style="{StaticResource ActionButtonStyle}" Click="TestSettings_Click" />
                                <Button Grid.Row="1" x:Name="ClearSelectedInputButton" Content="선택 입력 비우기" Margin="0,8,4,0"
                                        AutomationProperties.Name="선택 입력 비우기"
                                        Style="{StaticResource ActionButtonStyle}" Click="ClearSelectedInput_Click" />
                                <Button Grid.Row="1" Grid.Column="1" x:Name="SaveSettingsButton" Content="변경 내용 적용" IsEnabled="False" Margin="4,8,0,0"
                                        AutomationProperties.Name="변경 내용 적용"
                                        Style="{StaticResource ActionButtonStyle}" Click="SaveSettings_Click" />
                                <Button Grid.Row="2" Grid.ColumnSpan="2" x:Name="ApplyBlankConfigurationButton" Content="현재 레이어 전체 비우기" IsEnabled="False" Margin="0,8,0,0"
                                        AutomationProperties.Name="현재 레이어 전체 비우기"
                                        Style="{StaticResource ActionButtonStyle}" Click="ApplyBlankConfiguration_Click" />
                                <Button Grid.Row="3" Grid.ColumnSpan="2" x:Name="RestoreLatestBackupButton" Content="최근 백업으로 복원" IsEnabled="False" Margin="0,8,0,0"
                                        AutomationProperties.Name="최근 장치 백업으로 복원"
                                        Style="{StaticResource ActionButtonStyle}" Click="RestoreLatestBackup_Click" />
                            </Grid>
                            <TextBlock x:Name="SettingsStatusText"
                                       Text="USB 장치를 확인한 뒤 저장할 수 있습니다"
                                       Margin="0,10,0,0" Foreground="#9FB4B6" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,16">
                        <StackPanel x:Name="LedControlsPanel">
                            <TextBlock Text="LED 세팅" FontFamily="Bahnschrift SemiCondensed" FontSize="20" Foreground="#F4FAF7" />
                            <TextBlock Text="USB 연결 중에만 LED가 켜집니다" Margin="0,5,0,16" Foreground="{StaticResource MutedBrush}" FontSize="12" />

                            <Border Style="{StaticResource LedSubsectionHeaderStyle}" Margin="0,0,0,3">
                                <TextBlock Text="KEY별 기본 LED 색상" Style="{StaticResource LedSubsectionTitleStyle}" />
                            </Border>
                            <StackPanel x:Name="KeyLedEditorPanel">
                                <TextBlock x:Name="KeyLedContextText" Text="선택한 키 · KEY 1"
                                           Margin="2,5,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                <UniformGrid x:Name="KeyLedPalette" Columns="4" Margin="0,8,0,0">
                                    <Button Height="28" Margin="2" Background="#1683FF" Tag="blue" ToolTip="파란색" Click="KeyLedColor_Click" Style="{StaticResource ColorPreviewButtonStyle}" AutomationProperties.Name="선택 키 파란색" />
                                    <Button Height="28" Margin="2" Background="#FFB000" Tag="yellow" ToolTip="노란색" Click="KeyLedColor_Click" Style="{StaticResource ColorPreviewButtonStyle}" AutomationProperties.Name="선택 키 노란색" />
                                    <Button Height="28" Margin="2" Background="#20C878" Tag="green" ToolTip="초록색" Click="KeyLedColor_Click" Style="{StaticResource ColorPreviewButtonStyle}" AutomationProperties.Name="선택 키 초록색" />
                                    <Button Height="28" Margin="2" Background="#F04444" Tag="red" ToolTip="빨간색" Click="KeyLedColor_Click" Style="{StaticResource ColorPreviewButtonStyle}" AutomationProperties.Name="선택 키 빨간색" />
                                    <Button Height="28" Margin="2" Background="#FF8030" Tag="orange" ToolTip="주황색" Click="KeyLedColor_Click" Style="{StaticResource ColorPreviewButtonStyle}" AutomationProperties.Name="선택 키 주황색" />
                                    <Button Height="28" Margin="2" Background="#00D8D8" Tag="cyan" ToolTip="청록색" Click="KeyLedColor_Click" Style="{StaticResource ColorPreviewButtonStyle}" AutomationProperties.Name="선택 키 청록색" />
                                    <Button Height="28" Margin="2" Background="#9B59E5" Tag="purple" ToolTip="보라색" Click="KeyLedColor_Click" Style="{StaticResource ColorPreviewButtonStyle}" AutomationProperties.Name="선택 키 보라색" />
                                    <Button Height="28" Margin="2" Background="#FF6699" Tag="pink" ToolTip="분홍색" Click="KeyLedColor_Click" Style="{StaticResource ColorPreviewButtonStyle}" AutomationProperties.Name="선택 키 분홍색" />
                                </UniformGrid>
                                <TextBlock x:Name="KeyLedSelectedColorText" Text="선택된 기본 색상 · 파란색"
                                           Margin="2,5,0,0" Foreground="#D7FFF6" FontSize="11" FontWeight="SemiBold" />
                                <Button x:Name="SaveKeyColorsButton" Content="기본 색상 저장 및 적용" IsEnabled="False"
                                        Margin="2,9,2,0" Style="{StaticResource ActionButtonStyle}"
                                        Click="SaveKeyColors_Click" AutomationProperties.Name="기본 색상 저장 및 적용" />
                                <TextBlock x:Name="KeyLedStatusText" Text="색상을 선택한 뒤 저장 및 적용을 누르세요"
                                           Margin="0,6,0,12" Foreground="#9FB4B6" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Style="{StaticResource LedSubsectionHeaderStyle}">
                                <TextBlock Text="Codex 완료 후 기본 색상 복원" Style="{StaticResource LedSubsectionTitleStyle}" />
                            </Border>
                            <StackPanel>
                                <CheckBox x:Name="RestoreKeyColorsCheckBox"
                                          Content="Codex 작업 완료 3초 후 키 전체 기본 색상으로 복원"
                                          Margin="2,7,0,0" Foreground="#DDEBE9" FontSize="11"
                                          Checked="RestoreKeyColorsCheckBox_Changed"
                                          Unchecked="RestoreKeyColorsCheckBox_Changed"
                                          AutomationProperties.Name="Codex 작업 완료 3초 후 키 전체 기본 색상으로 복원" />
                                <Button x:Name="SaveRestorePolicyButton" Content="복원 설정 저장" IsEnabled="False"
                                        Margin="2,9,2,0" Style="{StaticResource ActionButtonStyle}"
                                        Click="SaveRestorePolicy_Click" AutomationProperties.Name="복원 설정 저장" />
                                <TextBlock x:Name="RestorePolicyStatusText" Text="키 전체에 적용되는 저장된 복원 설정입니다"
                                           Margin="0,6,0,12" Foreground="#9FB4B6" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Style="{StaticResource LedSubsectionHeaderStyle}">
                                <TextBlock Text="Codex 상태별 색상" Style="{StaticResource LedSubsectionTitleStyle}" />
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="45*" />
                                    <ColumnDefinition Width="10*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="45*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="실행" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#BDD0D0" FontSize="13" FontWeight="Bold" />
                                <ComboBox x:Name="RunningColorCombo" Grid.Row="0" Grid.Column="1" Margin="0,3" Height="30" DisplayMemberPath="Label" HorizontalContentAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="승인" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#BDD0D0" FontSize="13" FontWeight="Bold" />
                                <ComboBox x:Name="ApprovalColorCombo" Grid.Row="0" Grid.Column="4" Margin="0,3" Height="30" DisplayMemberPath="Label" HorizontalContentAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="완료" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#BDD0D0" FontSize="13" FontWeight="Bold" />
                                <ComboBox x:Name="CompletedColorCombo" Grid.Row="1" Grid.Column="1" Margin="0,3" Height="30" DisplayMemberPath="Label" HorizontalContentAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="오류" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#BDD0D0" FontSize="13" FontWeight="Bold" />
                                <ComboBox x:Name="ErrorColorCombo" Grid.Row="1" Grid.Column="4" Margin="0,3" Height="30" DisplayMemberPath="Label" HorizontalContentAlignment="Center" />
                            </Grid>
                            <Button x:Name="SaveStatusColorsButton" Content="상태색 저장" Margin="2,7,2,5"
                                    Style="{StaticResource ActionButtonStyle}" Click="SaveStatusColors_Click" />
                            <TextBlock x:Name="StatusColorStatusText" Text="저장한 색은 다음 Codex 상태부터 사용됩니다"
                                       Margin="0,0,0,10" Foreground="#9FB4B6" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock x:Name="CodexSourceStatusText"
                                       Text="LED 범위: 전용 CLI·JSON 실행만 · 현재 활성 없음 · 최근 제외 없음"
                                       Margin="0,0,0,10" Foreground="#7FA7A5" FontSize="11" TextWrapping="Wrap"
                                       AutomationProperties.Name="Codex LED 출처 상태" />

                            <Border Style="{StaticResource LedSubsectionHeaderStyle}">
                                <TextBlock Text="저장된 상태색 수동 시험" Style="{StaticResource LedSubsectionTitleStyle}" />
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Button x:Name="RunningPreviewButton" Background="#1683FF" Tag="running" Click="StatusLedPreview_Click" AutomationProperties.Name="실행 상태 미리보기" Style="{StaticResource ColorPreviewButtonStyle}" />
                                    <TextBlock Text="실행" HorizontalAlignment="Center" Foreground="#BDD0D0" FontSize="11" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Button x:Name="ApprovalPreviewButton" Background="#FFB000" Tag="approval" Click="StatusLedPreview_Click" AutomationProperties.Name="승인 상태 미리보기" Style="{StaticResource ColorPreviewButtonStyle}" />
                                    <TextBlock Text="승인" HorizontalAlignment="Center" Foreground="#BDD0D0" FontSize="11" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Button x:Name="CompletedPreviewButton" Background="#20C878" Tag="completed" Click="StatusLedPreview_Click" AutomationProperties.Name="완료 상태 미리보기" Style="{StaticResource ColorPreviewButtonStyle}" />
                                    <TextBlock Text="완료" HorizontalAlignment="Center" Foreground="#BDD0D0" FontSize="11" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <Button x:Name="ErrorPreviewButton" Background="#F04444" Tag="error" Click="StatusLedPreview_Click" AutomationProperties.Name="오류 상태 미리보기" Style="{StaticResource ColorPreviewButtonStyle}" />
                                    <TextBlock Text="오류" HorizontalAlignment="Center" Foreground="#BDD0D0" FontSize="11" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="LedPreviewStatusText" Text="색상 블록을 누르면 실제 키보드에 미리보기됩니다"
                                       Margin="0,12,0,0" Foreground="#9FB4B6" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CODEX 훅 관리" FontFamily="Bahnschrift SemiCondensed" FontSize="20" Foreground="#F4FAF7" />
                                <ToggleButton x:Name="HookHelpToggleButton" Content="?"
                                              Style="{StaticResource HelpToggleButtonStyle}"
                                              AutomationProperties.Name="CODEX 훅 관리 설명"
                                              ToolTip="훅 관리 설명 보기" />
                            </StackPanel>
                            <TextBlock Text="기존 사용자 훅은 보존하고 이 앱의 7개 훅만 관리합니다"
                                       Margin="0,5,0,10" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                            <Border Margin="0,0,0,10" Padding="12,10"
                                    Background="#152D30" BorderBrush="#35575B" BorderThickness="1" CornerRadius="10"
                                    Visibility="{Binding IsChecked, ElementName=HookHelpToggleButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.Name="CODEX 훅 관리 설명 내용">
                                <StackPanel>
                                    <TextBlock Text="CODEX 훅 관리란?" Foreground="#D7FFF6" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="Codex 훅은 Codex CLI의 작업 단계마다 자동으로 호출되는 연결 지점입니다. 이 앱은 7개 훅에서 시작·실행·승인·완료·오류 상태를 로컬로 받아 키보드 LED에 표시합니다."
                                               Margin="0,6,0,0" Foreground="#DDEBE9" FontSize="11" LineHeight="18" TextWrapping="Wrap" />
                                    <TextBlock Text="• 설치 / 복구: 이 앱의 훅만 추가하거나 올바른 상태로 되돌립니다. 기존 사용자 훅은 보존합니다."
                                               Margin="0,8,0,0" Foreground="#C2D2D2" FontSize="11" LineHeight="18" TextWrapping="Wrap" />
                                    <TextBlock Text="• 검사: 7개 훅과 실행 파일이 현재 설정에 정상 연결됐는지 확인합니다."
                                               Margin="0,3,0,0" Foreground="#C2D2D2" FontSize="11" LineHeight="18" TextWrapping="Wrap" />
                                    <TextBlock Text="• 제거: 이 앱이 추가한 훅만 제거하고 다른 훅은 남겨 둡니다."
                                               Margin="0,3,0,0" Foreground="#C2D2D2" FontSize="11" LineHeight="18" TextWrapping="Wrap" />
                                    <TextBlock Text="프롬프트와 대화 내용은 보내거나 저장하지 않으며, 상태 전달에는 네트워크를 사용하지 않습니다."
                                               Margin="0,8,0,0" Foreground="#7FCFC0" FontSize="11" LineHeight="18" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <UniformGrid Columns="3">
                                <Button x:Name="InstallHooksButton" Content="설치 / 복구" Margin="2" Style="{StaticResource ActionButtonStyle}" Click="InstallHooks_Click" />
                                <Button x:Name="InspectHooksButton" Content="검사" Margin="2" Style="{StaticResource ActionButtonStyle}" Click="InspectHooks_Click" />
                                <Button x:Name="RemoveHooksButton" Content="제거" Margin="2" Style="{StaticResource ActionButtonStyle}" Click="RemoveHooks_Click" />
                            </UniformGrid>
                            <TextBlock x:Name="HookStatusText" Text="Codex 훅 상태를 확인합니다"
                                       Margin="0,10,0,4" Foreground="#9FB4B6" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="설치 또는 실행 파일 변경 후 새 Codex CLI에서 /hooks를 열어 직접 검토하고 신뢰해야 합니다"
                                       Foreground="#FFCB5B" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
